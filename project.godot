; Open this file with Godot 4.6 or later.
config_version=5

[application]
config/name="PRISM · 像素宝石"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://assets/icon.svg"

[display]
window/size/viewport_width=1280
window/size/viewport_height=860
window/size/window_width_override=1280
window/size/window_height_override=860
window/size/resizable=true
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
anti_aliasing/quality/msaa_3d=0
anti_aliasing/quality/screen_space_aa=0
environment/defaults/default_clear_color=Color(0.94, 0.94, 0.91, 1)

[debug]
gdscript/warnings/untyped_declaration=0

[filesystem]
import/blender/enabled=false
